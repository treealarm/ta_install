# Applied by TaVmsHost on top of ../.env (installed as ta_vms.env), which holds everything Windows
# shares with the Docker deployment. Only what differs goes here; site.env, written once by the
# installer, overrides both for this one machine.
#
# ${TAVMS_HOME} is the installation directory, ${TAVMS_DATA} the data directory
# (%ProgramData%\TreeAlarm\VMS).

# Everything runs on this one machine: no compose network, no service names to resolve. The IPv4
# loopback rather than "localhost": MediaMTX and RabbitMQ listen on 127.0.0.1 only, and on Windows
# a connection that tries ::1 first waits about two seconds for the refusal before falling back.
POSTGRES_HOST=127.0.0.1
VMS_MTX_HOST=127.0.0.1

# Read only by TaVmsHost, to write the pub/sub component: in Docker the host is a compose service
# name written literally into the component file. RABBITMQ_PORT is per installation (site.env).
RABBITMQ_HOST=127.0.0.1

# Every fixed port here stays below 49152. Windows hands out reservations for Hyper-V, WSL and
# WinNAT from the dynamic range above it, differently on every machine and every boot, and a
# reserved port cannot be bound even though nothing listens on it ("access forbidden"). That is why
# Dapr itself puts placement on 6050 on Windows, and why these two differ from ../.env.
#
# Actor placement, run by TaVmsHost; the sidecars of vmsonvif, vmsonvif-actors, vmssingleton and
# vmsptztrackingsingleton are pointed at it. On a deployment over several machines, the core's;
# docker-compose.distributed.yml uses the same port, and so does Sentry's below.
DAPR_PLACEMENT_PORT=6050
DAPR_SENTRY_PORT=6055
# vms.exe's own gRPC port; only its sidecar connects to it.
GRPC_VMS_PORT=5150

# The culture the containers run in. With no LANG set there, every .NET service formats and parses
# numbers and dates the invariant way; on Windows it would take the system's locale instead, and on
# a Russian one "0.0003" stops being a number: web_srv rejected the corner coordinates of an
# uploaded plan picture, which ASP.NET binds from a form by the current culture. No service asks
# for a culture of its own, so nothing needs the locale data this switches off.
DOTNET_SYSTEM_GLOBALIZATION_INVARIANT=1

# Keycloak listens on DAPR_HOST_IP: the loopback here, where web_srv is its one client, and the
# core's address in a deployment over several machines, where every machine's web logs users in
# (TaVmsHost core and join put that KEYCLOAK_URL into site.env). The browser never talks to it. A
# fixed port below 49152, like the ones above, rather than one picked at install time: KEYCLOAK_URL
# is built from it here, before site.env is read.
KEYCLOAK_PORT=5160
KEYCLOAK_URL=http://127.0.0.1:${KEYCLOAK_PORT}

# MediaMTX runs on this machine (services.json "when"): always on a standalone installation and a
# core; a node joined with --no-mediamtx (the installer's NodeMediaMtx=0) has 0 in site.env, and
# its cameras publish to the core's.
TAVMS_MEDIAMTX=1

# What this machine is: standalone (everything here), core or node of a deployment over several
# machines (TaVmsHost's Role.cs). The installer sets core or node in site.env (Role=core|node);
# with it come how sidecars find each other — sqlite here, a file in the data directory that keeps
# every call on the loopback; Consul on a core or node — and what runs (services.json "roles").
TAVMS_ROLE=standalone
# The address each sidecar registers itself at (Dapr reads it from its environment; TaVmsHost
# passes it to every daprd). Without it Dapr takes the first non-loopback address. A core or node
# sets its own address in site.env: the one other machines reach it at.
DAPR_HOST_IP=127.0.0.1

# No roitrc on Windows: it does not build there. The fifth part of a pair is optional, and a node
# without one simply does not re-compress.
MEDIA_SERVER_PAIRS=vms:vmsfs:vmsonvif:vmslogger

# No analytics worker on Windows: video_a builds for Linux only. VmsAnalyticsSingleton still runs,
# for the analytics cameras report themselves over ONVIF.
DAPR_ANALYTICS_WORKER_APP_IDS=

# Logs stay on the system drive with the rest of the data. Archive and exports are asked for by the
# installer (site.env); these defaults only apply if it was not.
VMS_LOG_PATH=${TAVMS_DATA}\logs
VMS_STORAGE_BASE_PATH=${TAVMS_DATA}\media_storage
VMS_EXPORT_BASE_PATH=${TAVMS_DATA}\exports
