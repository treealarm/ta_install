// What TaVmsHost runs, in start order; it stops them in reverse. The Windows counterpart of
// ../docker-compose.yml (standalone) and ../docker-compose.distributed.yml (core, node): paths are
// relative to the installation directory, ${NAME} comes from the merged environment (StackConfig).
//
// "roles" names the machines an entry runs on (TAVMS_ROLE; none: all of them). A node runs only the
// services next to its cameras, under app ids that carry its name: ${TAVMS_NODE_SUFFIX} is
// "-<TAVMS_NODE_NAME>" there and empty elsewhere. This file is the one place a machine's app ids
// are fixed; a core mints a node's tokens from the node entries here.
//
// Sidecar ports are per app because every sidecar shares one localhost here, unlike in Docker where
// each sits in its app's network namespace on 3500/50001. They follow the F5 setup in ta_vms
// (ta_vms/dotnet/dapr.yaml), except the gRPC ones: 41001.. here rather than 51001.., because every
// fixed port must stay below 49152 on Windows (see windows.env). The app learns its own through
// DAPR_GRPC_PORT/DAPR_HTTP_PORT. docker-compose.distributed.yml uses the same numbers.
//
// Not here: roitrc and the analytics worker (no Windows build).
{
  "infrastructure": [
    // --- several machines: how they find each other and trust each other -------------------------
    {
      // Resolves app ids for every machine of the deployment; the nodes' agents join it. Its HTTP
      // API, which sidecars register through, stays on the loopback; DNS, gRPC and the WAN gossip
      // port (8302, for joining datacenters, of which a deployment has one) are off. The
      // sidecars start only after it answers: daprd with the Consul resolver exits otherwise.
      "name": "consul-server",
      "roles": ["core"],
      "exe": "consul\\consul.exe",
      "args": ["agent", "-server", "-bootstrap-expect=1", "-ui=false", "-datacenter=tavms", "-node=core",
               "-bind=${DAPR_HOST_IP}", "-client=127.0.0.1",
               // The gossip key: 'TaVmsHost core' and 'join' write it there, off the command line.
               "-config-file=${TAVMS_DATA}\\distributed\\consul.json",
               "-data-dir=${TAVMS_DATA}\\consul", "-dns-port=-1", "-grpc-port=-1", "-grpc-tls-port=-1",
               "-serf-wan-port=-1",
               // Raft's default log store, wal, fsyncs its directory, which Windows refuses ("sync
               // ...\raft\wal: Access is denied"): the server would die on its first start and
               // whenever it opens or removes a log segment after that.
               "-hcl=raft_logstore { backend = \"boltdb\" }"],
      // Otherwise it asks checkpoint-api.hashicorp.com for news of a newer version.
      "env": { "CHECKPOINT_DISABLE": "1" },
      "readyPort": "8500"
    },
    {
      "name": "consul-agent",
      "roles": ["node"],
      "exe": "consul\\consul.exe",
      "args": ["agent", "-ui=false", "-datacenter=tavms", "-node=${TAVMS_NODE_NAME}",
               "-bind=${DAPR_HOST_IP}", "-client=127.0.0.1", "-retry-join=${CORE_ADDRESS}",
               "-config-file=${TAVMS_DATA}\\distributed\\consul.json",
               "-data-dir=${TAVMS_DATA}\\consul", "-dns-port=-1", "-grpc-port=-1", "-grpc-tls-port=-1"],
      "env": { "CHECKPOINT_DISABLE": "1" },
      "readyPort": "8500"
    },
    {
      // Dapr's certificate authority: signs a sidecar's certificate against the token for its app
      // id (distributed\sentry\config.yaml, written by TaVmsHost core with the root and issuer).
      "name": "sentry",
      "roles": ["core"],
      "exe": "dapr\\sentry.exe",
      "args": ["--config", "${TAVMS_DATA}\\distributed\\sentry\\config.yaml",
               "--issuer-credentials", "${TAVMS_DATA}\\distributed\\sentry", "--trust-domain", "localhost",
               "--port", "${DAPR_SENTRY_PORT}", "--listen-address", "${DAPR_HOST_IP}",
               "--healthz-port", "6061", "--metrics-port", "9209"],
      "readyPort": "${DAPR_SENTRY_PORT}",
      "readyAddress": "${DAPR_HOST_IP}"
    },
    // --- this machine -----------------------------------------------------------------------------
    {
      "name": "placement",
      "roles": ["standalone"],
      "exe": "dapr\\placement.exe",
      // Loopback only: every sidecar is on this machine. Health and metrics moved off their
      // defaults (8080, 9090), the two ports most likely to be taken on a customer's machine.
      "args": ["--port", "${DAPR_PLACEMENT_PORT}", "--listen-address", "127.0.0.1",
               "--healthz-port", "6051", "--healthz-listen-address", "127.0.0.1", "--metrics-port", "9208"],
      "readyPort": "${DAPR_PLACEMENT_PORT}"
    },
    {
      // The core's: every machine's actor sidecars connect to it, over TLS with Sentry's certificate.
      "name": "placement",
      "roles": ["core"],
      "exe": "dapr\\placement.exe",
      "args": ["--port", "${DAPR_PLACEMENT_PORT}", "--listen-address", "${DAPR_HOST_IP}",
               "--healthz-port", "6051", "--healthz-listen-address", "127.0.0.1", "--metrics-port", "9208",
               "--tls-enabled", "--trust-anchors-file", "${TAVMS_DATA}\\distributed\\sentry\\ca.crt",
               "--sentry-address", "${CORE_ADDRESS}:${DAPR_SENTRY_PORT}"],
      "env": { "DAPR_SENTRY_TOKEN_FILE": "${TAVMS_DATA}\\distributed\\tokens\\dapr-placement.token" },
      "readyPort": "${DAPR_PLACEMENT_PORT}",
      "readyAddress": "${DAPR_HOST_IP}"
    },
    {
      // On every machine, but a node may go without it (TAVMS_MEDIAMTX=0, windows.env): then its
      // cameras publish to the core's.
      "name": "mediamtx",
      "when": "${TAVMS_MEDIAMTX}",
      "exe": "mediamtx\\mediamtx.exe",
      "args": ["${TAVMS_HOME}\\mediamtx\\mediamtx.yml"],
      "env": {
        // The same yml as Docker. Passwords as in ta_install's compose — on a node the core's, which
        // come in its package, so that one set of accounts serves every MediaMTX of a deployment.
        // The Control API and WHEP are on DAPR_HOST_IP: the loopback on one machine; over several,
        // the address VmsCfg's MediaMTX row names, since VmsUtils and every machine's web reach them
        // there. What nothing uses at all is off, so that MediaMTX cannot fail to start because
        // some other program on the machine already holds 1935, 8888 or 8890.
        "MTX_AUTHINTERNALUSERS_0_PASS": "${VMS_MEDIAMTX_PUBLISH_PASS}",
        "MTX_AUTHINTERNALUSERS_1_PASS": "${VMS_MEDIAMTX_READ_PASS}",
        "MTX_APIADDRESS": "${DAPR_HOST_IP}:9997",
        "MTX_WEBRTCADDRESS": "${DAPR_HOST_IP}:8889",
        // RTSP on IPv4 only. The yml's ":8554" is [::] with IPv4 mapped in, and Windows lets another
        // program listen on 0.0.0.0:8554 beside it without an error to either: every publish to
        // 127.0.0.1 then reaches the more specific socket, the other program's. On 0.0.0.0 the
        // second of the two to start fails to bind instead, and if that is MediaMTX, the host names
        // the holder ("ports" below). Nothing reaches MediaMTX's RTSP over IPv6.
        "MTX_RTSPADDRESS": "0.0.0.0:8554",
        "MTX_RTMP": "no",
        "MTX_HLS": "no",
        "MTX_SRT": "no",
        // MoQ (Media over QUIC), on by default in newer MediaMTX: reading and publishing on
        // 8892/8893 past the web, which nothing of ours uses.
        "MTX_MOQ": "no"
      },
      "ports": ["8554", "8889", "9997"],
      "readyPort": "9997",
      "readyAddress": "${DAPR_HOST_IP}"
    },
    {
      // Users and login. Built for PostgreSQL when the installer was made (Build-Stage.ps1 runs
      // `kc build`), so it starts --optimized; the realm is imported from keycloak\data\import on
      // the first start and left alone afterwards. Only web-vms talks to it: on the loopback on one
      // machine, at the core's address over several, where every machine's web logs users in.
      "name": "keycloak",
      "roles": ["standalone", "core"],
      "exe": "keycloak\\bin\\kc.bat",
      "args": ["start", "--optimized", "--import-realm"],
      "env": {
        "JAVA_HOME": "${TAVMS_HOME}\\jre",
        "KC_DB_URL": "jdbc:postgresql://127.0.0.1:${POSTGRES_PORT}/${POSTGRES_KEYCLOAK_DB}",
        "KC_DB_USERNAME": "${POSTGRES_USER}",
        "KC_DB_PASSWORD": "${POSTGRES_PASSWORD}",
        "KC_HTTP_ENABLED": "true",
        "KC_HTTP_HOST": "${DAPR_HOST_IP}",
        "KC_HTTP_PORT": "${KEYCLOAK_PORT}",
        "KC_HOSTNAME_STRICT": "false",
        // One server: a local cache. The default clusters through JGroups and listens for other
        // nodes on the LAN address (7800, 57800).
        "KC_CACHE": "local",
        "KC_BOOTSTRAP_ADMIN_USERNAME": "${KEYCLOAK_ADMIN_USER}",
        "KC_BOOTSTRAP_ADMIN_PASSWORD": "${KEYCLOAK_ADMIN_PASSWORD}",
        // Read by realm.json's placeholders.
        "KEYCLOAK_REALM_NAME": "${KEYCLOAK_REALM_NAME}",
        "KEYCLOAK_CLIENT_ID": "${KEYCLOAK_CLIENT_ID}",
        // Keycloak sizes its heap from the machine's memory (70%) when given no limit.
        "JAVA_OPTS_KC_HEAP": "-Xms64m -Xmx512m"
      }
      // No readyPort: the services after it do not need it, and waiting for its 20-50 s start would
      // hold back recording after every boot.
    },
    {
      // User administration: multitenant_admin in its standalone mode, for this realm's
      // administrators. Reachable from the LAN (a firewall rule), behind its own login.
      "name": "mt_admin",
      "roles": ["standalone", "core"],
      "exe": "mt_admin\\mt_admin.Server.exe",
      "env": {
        "MT_ADMIN_REALM": "${KEYCLOAK_REALM_NAME}",
        "KEYCLOAK_URL": "${KEYCLOAK_URL}",
        "KEYCLOAK_ADMIN_USER": "${KEYCLOAK_ADMIN_USER}",
        "KEYCLOAK_ADMIN_PASSWORD": "${KEYCLOAK_ADMIN_PASSWORD}",
        "KEYCLOAK_CLIENT_ID": "${KEYCLOAK_CLIENT_ID}",
        "HTTP_ADMIN_PORT": "${MT_ADMIN_PORT}",
        "DOTNET_SYSTEM_GLOBALIZATION_INVARIANT": "1"
      }
    }
  ],
  "apps": [
    // System-wide: on the core (or the one machine) only.
    { "appId": "vmscfg", "roles": ["standalone", "core"], "exe": "dotnet\\VmsCfg\\VmsCfg.exe", "protocol": "grpc", "appPort": "${CFG_VMS_PORT}",
      "daprHttpPort": 3601, "daprGrpcPort": 41002, "daprInternalGrpcPort": 19012, "metricsPort": 9191, "placement": false },
    { "appId": "vmsutils", "roles": ["standalone", "core"], "exe": "dotnet\\VmsUtils\\VmsUtils.exe", "protocol": "grpc", "appPort": "${UTILS_VMS_PORT}",
      "daprHttpPort": 3606, "daprGrpcPort": 41007, "daprInternalGrpcPort": 19017, "metricsPort": 9196, "placement": false },
    // A node's own, and the core's as a node with the standalone app ids.
    { "appId": "vmslogger${TAVMS_NODE_SUFFIX}", "exe": "dotnet\\VmsLogger\\VmsLogger.exe", "protocol": "grpc", "appPort": "${LOGGER_VMS_PORT}",
      "daprHttpPort": 3605, "daprGrpcPort": 41006, "daprInternalGrpcPort": 19016, "metricsPort": 9195, "placement": false },
    { "appId": "vmsfs${TAVMS_NODE_SUFFIX}", "exe": "dotnet\\VmsFs\\VmsFs.exe", "protocol": "grpc", "appPort": "${FS_VMS_PORT}",
      "daprHttpPort": 3604, "daprGrpcPort": 41005, "daprInternalGrpcPort": 19015, "metricsPort": 9194, "placement": false },
    { "appId": "vmssingleton", "roles": ["standalone", "core"], "exe": "dotnet\\VmsSingleton\\VmsSingleton.exe", "protocol": "grpc", "appPort": "${SINGLETON_VMS_PORT}",
      "daprHttpPort": 3613, "daprGrpcPort": 41014, "daprInternalGrpcPort": 19024, "metricsPort": 9203, "placement": true },
    { "appId": "vmsonvif${TAVMS_NODE_SUFFIX}", "exe": "dotnet\\VmsOnvif\\VmsOnvif.exe", "protocol": "grpc", "appPort": "${ONVIF_SRV_PORT}",
      "daprHttpPort": 3602, "daprGrpcPort": 41003, "daprInternalGrpcPort": 19013, "metricsPort": 9192, "placement": true,
      "env": { "OWN_SERVER_ID": "vms${TAVMS_NODE_SUFFIX}" } },
    { "appId": "vmsonvif-actors${TAVMS_NODE_SUFFIX}", "exe": "dotnet\\VmsOnvifActors\\VmsOnvifActors.exe", "protocol": "http", "appPort": "${ONVIF_ACTORS_PORT}",
      "daprHttpPort": 3603, "daprGrpcPort": 41004, "daprInternalGrpcPort": 19014, "metricsPort": 9193, "placement": true,
      "env": { "OWN_SERVER_ID": "vms${TAVMS_NODE_SUFFIX}" } },
    { "appId": "vmsanalyticssingleton", "roles": ["standalone", "core"], "exe": "dotnet\\VmsAnalyticsSingleton\\VmsAnalyticsSingleton.exe", "protocol": "grpc", "appPort": "${ANALYTICS_VMS_PORT}",
      "daprHttpPort": 3610, "daprGrpcPort": 41011, "daprInternalGrpcPort": 19021, "metricsPort": 9200, "placement": false },
    { "appId": "vmsptztrackingsingleton", "roles": ["standalone", "core"], "exe": "dotnet\\VmsPtzTrackingSingleton\\VmsPtzTrackingSingleton.exe", "protocol": "grpc", "appPort": "${PTZ_TRACKING_VMS_PORT}",
      "daprHttpPort": 3616, "daprGrpcPort": 41017, "daprInternalGrpcPort": 19027, "metricsPort": 9206, "placement": true },
    { "appId": "vms${TAVMS_NODE_SUFFIX}", "exe": "vms\\vms.exe", "protocol": "grpc", "appPort": "${GRPC_VMS_PORT}",
      "daprHttpPort": 3607, "daprGrpcPort": 41008, "daprInternalGrpcPort": 19018, "metricsPort": 9197, "placement": false },
    // On every machine: an operator opens any of them and sees the whole deployment. Nothing calls
    // it by app id; a node's carries its name like the rest of the node's.
    { "appId": "web-vms${TAVMS_NODE_SUFFIX}", "exe": "dotnet\\web_srv.Server\\web_srv.Server.exe", "protocol": "http", "appPort": "${WEB_VMS_PORT}",
      "daprHttpPort": 3600, "daprGrpcPort": 41001, "daprInternalGrpcPort": 19011, "metricsPort": 9190, "placement": false }
  ]
}
