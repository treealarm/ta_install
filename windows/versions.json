// Third-party components bundled into the Windows installer. Unlike docker-compose.yml, which
// follows `latest`, an installer carries the binaries themselves, so every version is exact and
// every download is checked against its hash (the GitHub release digest where there is one).
// scripts/Build-Stage.ps1 downloads, verifies and unpacks them.
//
// license and licenseFile feed THIRD-PARTY-NOTICES.txt, which Build-Stage.ps1 writes; licenseFile
// is where the full text sits in the installation, and the build fails if it is not there. The two
// runtime installers carry their own licences and install them with the runtime.
//
// Bumping one: change url and hash together. RabbitMQ and Erlang/OTP move as a pair — see
// https://www.rabbitmq.com/docs/which-erlang (4.3 needs Erlang 27.0 or later). PostgreSQL stays on
// one major: a new major needs pg_upgrade of the installed data, which the installer does not do.
{
  "postgresql": {
    "version": "18.6-1",
    "license": "PostgreSQL License",
    "licenseFile": "pgsql\\server_license.txt",
    "url": "https://get.enterprisedb.com/postgresql/postgresql-18.6-1-windows-x64-binaries.zip",
    "sha256": "fbe23da234ee31547bf8a36d29dfd81e82b849df2d2b78d2eecb43d360252f8c"
  },
  // The portable zip, not the NSIS installer: no Add/Remove entry of its own. The VC++
  // redistributable it carries is dropped: the one shipped comes with the ta_vms build, from the
  // toolset that compiled vms.exe, and is new enough for Erlang and PostgreSQL too.
  "erlang": {
    "version": "28.5.0.7",
    "license": "Apache-2.0",
    "licenseFile": "licenses\\Erlang-OTP.txt",
    "url": "https://github.com/erlang/otp/releases/download/OTP-28.5.0.7/otp_win64_28.5.0.7.zip",
    "sha256": "9ff998d7a612b6697f6f737078783557bced63e5bf2a96a9d5f7d7d2a840cb98"
  },
  "rabbitmq": {
    "version": "4.3.6",
