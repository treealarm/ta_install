<Project Sdk="WixToolset.Sdk/5.0.2">
  <!--
    ta_vms-x64.msi: the directory scripts/Build-Stage.ps1 laid out, and the custom actions that run
    the PowerShell scripts in it. Built through ../Bundle/Bundle.wixproj, which references it;
    on its own:

      dotnet build Package.wixproj -c Release -p:StageDir=<stage> -p:Version=<x.y.z>
  -->
  <PropertyGroup>
    <OutputType>Package</OutputType>
    <OutputName>ta_vms-x64</OutputName>
    <InstallerPlatform>x64</InstallerPlatform>
    <Version Condition="'$(Version)' == ''">0.0.0</Version>
    <DefineConstants>ProductVersion=$(Version)</DefineConstants>
    <!-- 5 760 files with generated component GUIDs: ICE validation adds minutes and finds only
         what the stage layout makes inevitable (ICE03 on file names, ICE60 on versioned files). -->
    <SuppressValidation>true</SuppressValidation>
  </PropertyGroup>

  <Target Name="RequireStage" BeforeTargets="BeforeBuild">
    <Error Condition="'$(StageDir)' == '' or !Exists('$(StageDir)\host\TaVmsHost.exe')"
           Text="Pass -p:StageDir=&lt;the directory scripts/Build-Stage.ps1 laid out&gt;." />
  </Target>

  <ItemGroup>
    <BindPath Include="$(StageDir)">
      <BindName>Stage</BindName>
    </BindPath>
    <BindPath Include="$(MSBuildThisFileDirectory)..">
      <BindName>Installer</BindName>
    </BindPath>
    <PackageReference Include="WixToolset.Util.wixext" Version="5.0.2" />
  </ItemGroup>
</Project>
