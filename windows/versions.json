    "url": "https://github.com/dapr/dapr/releases/download/v1.18.7/daprd_windows_amd64.zip",
    "sha256": "3bba7e9808b3c83383628a3c022045b45328d3a8700c85c95788fb3a05fa1cd9"
  },
  "placement": {
