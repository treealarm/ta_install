GRPC_VMS_PORT=50051
CFG_VMS_PORT=5135
FS_VMS_PORT=5137
LOGGER_VMS_PORT=5138
ONVIF_SRV_PORT=5136
ONVIF_ACTORS_PORT=5141
UTILS_VMS_PORT=5139
SINGLETON_VMS_PORT=5145
ANALYTICS_VMS_PORT=5140
DAPR_GRPC_PORT=50001
WEB_VMS_PORT=5134
DAPR_CFG_APP_ID="vmscfg"
DAPR_ONVIF_APP_ID="vmsonvif"
DAPR_LOGGER_APP_ID="vmslogger"
DAPR_UTILS_APP_ID="vmsutils"
# The one service that must never be replicated: it holds work that has to happen exactly
# once and in-memory aggregation a second instance would split rather than share.
DAPR_SINGLETON_APP_ID="vmssingleton"
DAPR_ANALYTICS_APP_ID="vmsanalytics"
# One entry per node: media server, the VmsFs that owns its archive volume, and the VmsOnvif
# that shares its camera subnet. All three sit on the same machine — ONVIF reaches a camera
# over the same local network RTSP does, so a central instance would have no route to it.
MEDIA_SERVER_PAIRS=vms:vmsfs:vmsonvif
DAPR_STATE_STORE_NAME=statestore
PUBSUB_NAME="orderpubsub"

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_CFG_DB=ta_cfg
POSTGRES_FS_DB=ta_fs
POSTGRES_ANALYTICS_DB=ta_analytics

ANALYTICS_DEBOUNCE_SECONDS=10
# Re-identification (in-memory): min cosine similarity [0..1] to treat a body embedding as the same
# object, how long a sighting stays in the match gallery, and the gap after which the same object
# starts a new event_id group (episodes within the gap group together in the Events tree).
ANALYTICS_REID_MATCH_MIN_SCORE=0.6
ANALYTICS_REID_GALLERY_WINDOW_SECONDS=900
ANALYTICS_EVENT_GROUP_GAP_SECONDS=300
# The bundled video_a worker (analytics-worker service in docker-compose.yml). Comma-separated
# list; watches are sharded across entries by rendezvous hash.
DAPR_ANALYTICS_WORKER_APP_IDS=analytics-worker

# How often (seconds, 1..86400) a still-live person track recomputes its body re-id embedding.
# The embedding is computed on the track's first frame and re-sent with every detection, so this
# only bounds recomputation. Not optional: the analytics worker exits on a missing, non-numeric or
# out-of-range value.
ANALYTICS_REID_EMBED_INTERVAL_SEC=15

VMS_MTX_HOST="mediamtx"

# MediaMTX service accounts — CHANGE THESE PASSWORDS ON EVERY INSTALLATION. MediaMTX no longer
# allows anonymous access (init_files/config/mediamtx.yml), so anyone holding the read password can
# pull any camera straight from MediaMTX, and anyone holding the publish password can overwrite a
# camera's stream. The passwords reach MediaMTX as MTX_AUTHINTERNALUSERS_<i>_PASS, see
# docker-compose.yml.
#   publish — media_server, pushing camera streams over RTSP
#   read    — the web_vms WHEP gateway, VmsAnalytics' RTSP pull, VmsUtils' Control API calls
VMS_MEDIAMTX_PUBLISH_USER=vms_publish
VMS_MEDIAMTX_PUBLISH_PASS=change_me_publish
VMS_MEDIAMTX_READ_USER=vms_read
VMS_MEDIAMTX_READ_PASS=change_me_read

# Seals the opaque WHEP session tokens web_vms hands to browsers. This is a working default so the
# stack starts out of the box — replace it like the passwords above: `openssl rand -base64 32`.
# Must decode to exactly 32 bytes, and must be identical across web_vms replicas if you run more
# than one, since the token is how any replica learns which MediaMTX session to close.
VMS_WHEP_SESSION_KEY=L3uSKvD4GzgwEcRKnXKmiBMJUGl+MwFPU0xtNKnoNB8=

VMS_STORAGE_BASE_PATH = /data/media_storage
# Camera-side (edge) archive imports exported as downloadable mp4 files. Deliberately outside the
# storage roots: these are not archive clips and must not appear on the recording timeline.
VMS_EXPORT_BASE_PATH = /data/exports
# How long an export stays downloadable before EdgeExportCleaner removes it.
VMS_EDGE_EXPORT_TTL_HOURS = 24
# One exported mp4 per this many seconds: a single multi-gigabyte file is awkward to download and
# cannot be previewed without pulling all of it.
VMS_EDGE_EXPORT_CHUNK_SECONDS = 60
VMS_LOG_PATH = /data/logs

# Source liveness — how the archive learns it had a hole. media_server heartbeats every stream it
# reads; VmsFs turns silence into rows of source_outages. Interval boundaries come from the last
# frame timestamp, so the period below sets only how fast an outage is noticed, not how precisely
# it is recorded.
VMS_SOURCE_LIVENESS_PERIOD_SECONDS = 15
# VmsFs: no heartbeat for longer than this means the source is gone (camera or the media server).
VMS_SOURCE_LIVENESS_STALE_SECONDS = 60
# VmsFs: an outage shorter than this is a blink and never reaches the table. Also collapses a
# flapping camera into one row instead of thousands.
VMS_SOURCE_OUTAGE_GRACE_SECONDS = 15
# Debug "Entity State" feed: media_server publishes one message per stream every this many seconds,
# and event-driven publishers (VmsAnalytics) report at all. Unset or 0 turns the feed off entirely.
# Its volume is streams divided by this period, on the bus shared with Square, so it is deliberately
# slower here than in dev — raise it further, or drop it to 0, on a large installation.
VMS_DEBUG_ENTITY_STATE_SECONDS = 60
# VmsFs: closed outage rows are removed after this many days. Open ones are kept regardless of age.
VMS_OUTAGE_RETENTION_DAYS = 90
# Automatic recovery of archive gaps from the camera's own storage. Enabled per stream in the camera
# settings, never globally: a replay pull takes one of the camera's few RTSP sessions.
# A camera does not offer a just-recorded stretch for replay immediately, so a gap is left to settle
# before the first attempt — asking too early returns nothing and burns an attempt.
VMS_BACKFILL_SETTLE_SECONDS = 60
# Minimum spacing between attempts on the same gap.
VMS_BACKFILL_RETRY_SECONDS = 300
# Nothing older than this is attempted; the card holds about an hour, so this is already generous.
VMS_BACKFILL_LOOKBACK_HOURS = 48
# Finished import jobs are operational history and age out quickly; queued and running ones are
# never removed by age — an interrupted job returns to the queue through its expired lease.
VMS_BACKFILL_JOB_RETENTION_HOURS = 24

ASPNETCORE_ENVIRONMENT=Development

# Optional: shared Keycloak login (Square's realm). Leave KEYCLOAK_URL empty to run web_vms
# standalone with no auth, exactly as before.
KEYCLOAK_URL=
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_REALM_NAME=myrealm
KEYCLOAK_CLIENT_ID=pubclient

# Optional, dev-only: enables the unauthenticated /test/live page + api/live/whep-test/*
# endpoints for testing the MediaMTX WHEP proxy in isolation. Must stay unset in production.
VMS_LIVE_TEST_PLAYER=

# Optional: push ta_vms's cameras/properties/alarms into Square's map. Leave empty to run VmsCfg
# standalone with no Square dependency (see docs/square-integration-plan.md).
SQUARE_INTEGRATION_SINK_APP_ID=
SQUARE_INTEGRATION_DEFAULT_LAT=0
SQUARE_INTEGRATION_DEFAULT_LON=0
# Optional: origin of Square's frontend — enables CORS on web_vms for its Monitor tab.
SQUARE_FRONTEND_ORIGIN=